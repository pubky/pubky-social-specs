{
  "name": "pubky-social-specs",
  "version": "1.0.0-beta.1",
  "description": "The Pubky social data model: builders, validation and URIs as plain synchronous functions",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./migration": {
      "types": "./dist/migration/index.d.ts",
      "default": "./dist/migration/index.js"
    },
    "./migration/pubky-sdk": {
      "types": "./dist/migration/adapters/pubky-sdk.d.ts",
      "default": "./dist/migration/adapters/pubky-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pubky-social-migrate": "bin/migrate.js"
  },
  "files": [
    "dist",
    "src",
    "!src/host.d.ts",
    "bin/migrate.js",
    "example.js",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "RUSTFLAGS=\"--remap-path-prefix=$HOME=~\" cargo run --locked --features migrator --bin bundle_specs_npm",
    "build:ts": "tsc -p .",
    "pretest": "tsc -p .",
    "test": "mocha vectors.test.js edges.test.js test.js property.test.js validate.test.js client.test.js transforms.test.js migration.test.js sdk-port.test.js cli.test.js && node qa/data.mjs --check && node --max-old-space-size=1536 qa/model.mjs --runs 25 --seed 1",
    "types": "tsc -p test-types",
    "size": "node qa/size.mjs",
    "score": "node --max-old-space-size=1536 qa/score.mjs",
    "model": "node --max-old-space-size=1536 qa/model.mjs",
    "mutation": "stryker run",
    "tools": "npm ci --ignore-scripts --prefix tools",
    "lint": "node tools/node_modules/eslint/bin/eslint.js -c tools/eslint.config.mjs --max-warnings 0 src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:src": "node --import ./qa/from-src.mjs node_modules/mocha/bin/mocha.js vectors.test.js edges.test.js test.js property.test.js validate.test.js client.test.js transforms.test.js migration.test.js sdk-port.test.js cli.test.js",
    "coverage": "node qa/coverage.mjs",
    "deps": "node tools/node_modules/dependency-cruiser/bin/dependency-cruiser.mjs --config tools/dependency-cruiser.cjs src",
    "e2e": "mocha e2e/migrate.e2e.js",
    "example": "node example.js",
    "api": "diff -u api/index.d.ts dist/index.d.ts && diff -u api/types.d.ts dist/types.d.ts && diff -u api/validate.d.ts dist/validate.d.ts && diff -u api/testing.d.ts dist/testing.d.ts && diff -u api/migration.d.ts dist/migration/index.d.ts && diff -u api/pubky-sdk.d.ts dist/migration/adapters/pubky-sdk.d.ts && diff -u api/client.d.ts dist/client/index.d.ts && diff -u api/session.d.ts dist/session.d.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@stryker-mutator/core": "^9.6.1",
    "@synonymdev/pubky": "^0.14.0",
    "c8": "^12.0.0",
    "esbuild": "^0.25.0",
    "fast-check": "^4.10.2",
    "mocha": "^12.0.3",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubky/pubky-social-specs.git"
  },
  "homepage": "https://github.com/pubky/pubky-social-specs#readme",
  "bugs": {
    "url": "https://github.com/pubky/pubky-social-specs/issues"
  },
  "contributors": [
    "SHAcollision",
    "tipogi",
    "ok300"
  ],
  "keywords": [
    "pubky",
    "social",
    "specs",
    "validation"
  ]
}
