{
  "name": "pubky-social-specs",
  "version": "1.0.0-beta.1",
  "description": "The Pubky social data model: builders, validation and URIs as plain synchronous functions",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./migration": {
      "types": "./dist/migration/index.d.ts",
      "default": "./dist/migration/index.js"
    },
    "./migration/pubky-sdk": {
      "types": "./dist/migration/adapters/pubky-sdk.d.ts",
      "default": "./dist/migration/adapters/pubky-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pubky-social-migrate": "bin/migrate.js"
  },
  "files": [
    "dist",
    "src",
    "!src/host.d.ts",
    "bin/migrate.js",
    "example.js"
  ],
  "scripts": {
    "build": "cargo run --features migrator --bin bundle_specs_npm",
    "build:ts": "tsc -p .",
    "pretest": "tsc -p .",
    "test": "mocha test.js transforms.test.js migration.test.js sdk-port.test.js cli.test.js && node qa/score.mjs --fuzz 0 && node qa/data.mjs --check",
    "types": "tsc -p test-types",
    "size": "node qa/size.mjs",
    "score": "node --max-old-space-size=1536 qa/score.mjs",
    "e2e": "mocha e2e/migrate.e2e.js",
    "example": "node example.js",
    "api": "diff -u api/index.d.ts dist/index.d.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0"
  },
  "devDependencies": {
    "@synonymdev/pubky": "^0.14.0",
    "esbuild": "^0.25.0",
    "mocha": "^11.7.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubky/pubky-social-specs.git"
  },
  "homepage": "https://github.com/pubky/pubky-social-specs#readme",
  "bugs": {
    "url": "https://github.com/pubky/pubky-social-specs/issues"
  },
  "contributors": [
    "SHAcollision",
    "tipogi",
    "ok300"
  ],
  "keywords": [
    "pubky",
    "social",
    "specs",
    "validation"
  ]
}
